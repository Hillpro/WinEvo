{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hillpro/WinEvo/blob/main/actions/schemas/action.schema.json",
  "title": "WinEvo Action Manifest",
  "description": "Declarative description of an optimizer/tweaker action executable by the WinEvo agent. This is the alpha-trimmed schema — it covers only what the runtime actually consumes today. The long-term target shape (with undo, dryRun, preconditions, sub-actions, restore points, progress events, additional operations) is preserved in docs/manifest-reference/action.schema.json.",
  "type": "object",
  "required": ["id", "version", "name", "category", "execution"],
  "additionalProperties": false,

  "properties": {
    "$schema":      { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$",
      "description": "Globally unique stable id. Format: <category>.<kebab-case-name>."
    },
    "version":      { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "name":         { "type": "string", "description": "Human-readable name in English (default). Translate via the 'localization' block." },
    "description":  { "type": "string", "description": "One-sentence description in English (default). Translate via the 'localization' block." },
    "category":     { "type": "string", "enum": ["customization", "resources", "storage", "updates", "third-party"] },
    "tags":         { "type": "array", "items": { "type": "string" } },
    "icon":         { "type": "string" },
    "author":       { "type": "string" },

    "requirements": { "$ref": "#/$defs/requirements" },
    "warnings":     { "type": "array", "items": { "$ref": "#/$defs/warning" } },
    "parameters":   { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
    "execution":    { "$ref": "#/$defs/execution" },
    "localization": { "$ref": "#/$defs/localization" }
  },

  "$defs": {

    "localization": {
      "type": "object",
      "description": "Per-language overrides for the manifest's inline text. Keys are IETF language tags (e.g. 'fr', 'es'). Top-level fields on the manifest are the English (en) base; any field not overridden falls back to English.",
      "additionalProperties": { "$ref": "#/$defs/localizationEntry" }
    },

    "localizationEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name":        { "type": "string" },
        "description": { "type": "string" },
        "parameters": {
          "type": "object",
          "description": "Per-parameter-id overrides. Keys must match a parameter id declared in the top-level 'parameters' array.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name":        { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },

    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "elevation": { "type": "string", "enum": ["required", "not-required", "optional"], "default": "not-required" }
      }
    },

    "warning": {
      "type": "object",
      "required": ["severity", "key"],
      "additionalProperties": false,
      "properties": {
        "severity": { "type": "string", "enum": ["info", "warning", "danger", "critical"] },
        "key":      { "type": "string" },
        "tokens":   { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },

    "parameter": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id":          { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
        "type":        { "type": "string", "enum": ["string", "integer", "boolean", "enum", "drive", "wifi-profile", "file-path", "directory-path", "service-name"] },
        "name":        { "type": "string", "description": "English name of the parameter. Translate via 'localization.<lang>.parameters.<id>.name'." },
        "description": { "type": "string", "description": "English description of the parameter. Translate via 'localization.<lang>.parameters.<id>.description'." },
        "required":    { "type": "boolean", "default": false },
        "default":     {}
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "integer" } } },
          "then": { "properties": { "min": { "type": "integer" }, "max": { "type": "integer" } } } },
        { "if": { "properties": { "type": { "const": "enum" } } },
          "then": { "required": ["choices"], "properties": { "choices": { "type": "array", "items": { "type": "string" }, "minItems": 1 } } } },
        { "if": { "properties": { "type": { "const": "drive" } } },
          "then": { "properties": { "filter": { "type": "object", "properties": { "driveType": { "type": "array", "items": { "type": "string", "enum": ["fixed", "removable", "network", "cdrom", "ramdisk"] } } } } } } }
      ]
    },

    "execution": {
      "type": "object",
      "required": ["steps"],
      "additionalProperties": false,
      "properties": {
        "mode":  { "type": "string", "enum": ["sequential", "sequential-continue-on-error"], "default": "sequential" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
      }
    },

    "step": {
      "type": "object",
      "required": ["operation"],
      "description": "A step that invokes an agent-side operation. Sub-action composition is target-only and lives in the reference snapshot.",
      "properties": {
        "kind":             { "const": "operation" },
        "id":               { "type": "string" },
        "operation":        { "type": "string", "enum": ["external-process", "builtin-tool", "powershell", "command", "registry-set", "registry-delete", "process-kill", "delay"] },
        "timeout":          { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] },
        "continueOnError":  { "type": "boolean", "default": false }
      },
      "additionalProperties": true
    }
  }
}
