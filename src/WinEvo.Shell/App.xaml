<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WinEvo.Shell.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Loads the default WinUI 3 theme dictionary (Fluent brushes,
                     styles like AccentButtonStyle, CardStrokeColorDefaultBrush, etc.).
                     Without this, x:Bind / ThemeResource lookups fail at parse time. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!-- Parameter-picker DataTemplates + selector. Consumers reference
                     {StaticResource ParameterInputTemplateSelector} from any XAML
                     in the Shell. Adding a new parameter type touches only
                     ParameterInputResources.xaml, not the consumers. -->
                <ResourceDictionary Source="ms-appx:///Resources/ParameterInputResources.xaml" />

                <!-- Interaction-mode templates (button / toggle / future). Selected
                     by InteractionTemplateSelector keyed off the controller type.
                     Adding a new mode touches only this dictionary, the selector,
                     and the controller-construction switch in ActionDetailViewModel. -->
                <ResourceDictionary Source="ms-appx:///Resources/InteractionTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
