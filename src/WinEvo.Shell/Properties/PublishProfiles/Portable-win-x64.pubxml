<?xml version="1.0" encoding="utf-8"?>
<!-- Portable self-contained publish for the win-x64 runtime. Bundles the
     .NET and WinAppSDK runtimes (the latter via the csproj's
     WindowsAppSDKSelfContained gate that activates on SelfContained=true),
     so the publish output runs on a clean Windows 11 box with no
     prerequisites. The Agent ends up in publish\agent\ via the
     CopyAgentBinariesToPublish target.

     Use:
       dotnet publish src/WinEvo.Shell -p:PublishProfile=Portable-win-x64
     Or pick "Portable-win-x64" from VS's Publish dialog. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
