<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinEvo.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinEvo.Shell.Core.ViewModels"
    Title="WinEvo">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="WinEvo" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Click="OnAboutClick"
                    ToolTipService.ToolTip="About WinEvo"
                    Padding="8,4"
                    Background="Transparent"
                    BorderThickness="0">
                <FontIcon Glyph="&#xE946;" FontSize="16" />
            </Button>
        </Grid>

        <!-- Body: master-detail -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: action list -->
            <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,1,0">
                <ListView
                    ItemsSource="{x:Bind ViewModel.Actions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedAction, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActionItemViewModel">
                            <StackPanel Padding="4" Spacing="2">
                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Category}" Opacity="0.6" FontSize="12" />
                                <TextBlock Text="{x:Bind DisplayDescription}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" MaxLines="2" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Right: detail -->
            <ScrollViewer Grid.Column="1" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock
                        Text="Select an action on the left."
                        Visibility="{x:Bind DetailInverseVisibility(ViewModel.Detail), Mode=OneWay}"
                        Opacity="0.6" />

                    <StackPanel Spacing="16"
                                Visibility="{x:Bind DetailVisibility(ViewModel.Detail), Mode=OneWay}">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="{x:Bind ViewModel.Detail.Item.DisplayName, Mode=OneWay, FallbackValue=''}"
                                FontSize="22" FontWeight="SemiBold" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Detail.Item.DisplayDescription, Mode=OneWay, FallbackValue=''}"
                                Opacity="0.75" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4" Padding="6,2">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.Detail.Item.Category, Mode=OneWay, FallbackValue=''}"
                                        FontSize="12" />
                                </Border>
                                <Border
                                    Background="{ThemeResource SystemFillColorCautionBrush}"
                                    CornerRadius="4" Padding="6,2"
                                    Visibility="{x:Bind ElevationVisibility(ViewModel.Detail), Mode=OneWay}">
                                    <TextBlock Text="needs elevation" FontSize="12" Foreground="White" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Interaction surface (button / toggle / future modes).
                             The template selector picks the per-mode DataTemplate
                             based on the runtime type of Detail.Interaction. -->
                        <ContentControl
                            Content="{x:Bind ViewModel.Detail.Interaction, Mode=OneWay}"
                            ContentTemplateSelector="{StaticResource InteractionTemplateSelector}"
                            HorizontalContentAlignment="Stretch" />

                        <!-- Status + result -->
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="{x:Bind ViewModel.Detail.Status, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Border
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4"
                                Padding="12"
                                Visibility="{x:Bind ResultDetailVisibility(ViewModel.Detail), Mode=OneWay}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.Detail.ResultDetail, Mode=OneWay}"
                                    FontFamily="Consolas, Cascadia Mono, monospace"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer: connection state, elevation, and active-execution count. -->
        <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock Text="{x:Bind ViewModel.AgentStatus, Mode=OneWay}"
                       FontSize="11" Opacity="0.6" />
        </Border>
    </Grid>

</Window>
