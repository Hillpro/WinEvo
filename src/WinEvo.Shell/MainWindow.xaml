<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinEvo.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinEvo.Shell.Core.ViewModels"
    Title="WinEvo">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="16,12" Spacing="12">
            <TextBlock Text="WinEvo" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="•" Opacity="0.4" VerticalAlignment="Center" />
            <TextBlock x:Name="HeaderStatus"
                       Text="{x:Bind ViewModel.AgentStatus, Mode=OneWay}"
                       Opacity="0.7"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Body: master-detail -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: action list -->
            <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,1,0">
                <ListView
                    ItemsSource="{x:Bind ViewModel.Actions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedAction, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActionItemViewModel">
                            <StackPanel Padding="4" Spacing="2">
                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Category}" Opacity="0.6" FontSize="12" />
                                <TextBlock Text="{x:Bind DisplayDescription}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" MaxLines="2" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Right: detail -->
            <ScrollViewer Grid.Column="1" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock
                        Text="Select an action on the left."
                        Visibility="{x:Bind DetailInverseVisibility(ViewModel.Detail), Mode=OneWay}"
                        Opacity="0.6" />

                    <StackPanel Spacing="16"
                                Visibility="{x:Bind DetailVisibility(ViewModel.Detail), Mode=OneWay}">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="{x:Bind ViewModel.Detail.Item.DisplayName, Mode=OneWay, FallbackValue=''}"
                                FontSize="22" FontWeight="SemiBold" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Detail.Item.DisplayDescription, Mode=OneWay, FallbackValue=''}"
                                Opacity="0.75" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4" Padding="6,2">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.Detail.Item.Category, Mode=OneWay, FallbackValue=''}"
                                        FontSize="12" />
                                </Border>
                                <Border
                                    Background="{ThemeResource SystemFillColorCautionBrush}"
                                    CornerRadius="4" Padding="6,2"
                                    Visibility="{x:Bind ElevationVisibility(ViewModel.Detail), Mode=OneWay}">
                                    <TextBlock Text="needs elevation" FontSize="12" Foreground="White" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Parameters -->
                        <StackPanel Spacing="8"
                                    Visibility="{x:Bind ParametersVisibility(ViewModel.Detail), Mode=OneWay}">
                            <TextBlock Text="Parameters" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Detail.Parameters, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ParameterInputViewModel">
                                        <StackPanel Spacing="4" Margin="0,0,0,12">
                                            <TextBlock>
                                                <Run Text="{x:Bind DisplayName}" />
                                                <Run Text=" (" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Run Text="{x:Bind Type}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Run Text=")" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                            <TextBox Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Execute -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                Content="Execute"
                                Command="{x:Bind ViewModel.Detail.ExecuteCommand, Mode=OneWay}"
                                Style="{ThemeResource AccentButtonStyle}" />
                            <ProgressRing
                                IsActive="{x:Bind ViewModel.Detail.IsRunning, Mode=OneWay, FallbackValue=False}"
                                Width="24" Height="24" />
                        </StackPanel>

                        <!-- Status + result -->
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="{x:Bind ViewModel.Detail.Status, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Border
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4"
                                Padding="12"
                                Visibility="{x:Bind ResultDetailVisibility(ViewModel.Detail), Mode=OneWay}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.Detail.ResultDetail, Mode=OneWay}"
                                    FontFamily="Consolas, Cascadia Mono, monospace"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock Text="Operations wired: registry-set, process-kill, external-process"
                       FontSize="11" Opacity="0.6" />
        </Border>
    </Grid>

</Window>
