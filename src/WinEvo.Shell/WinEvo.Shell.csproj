<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>WinEvo.Shell</RootNamespace>
    <!-- Output exe is WinEvo.exe (consumer-app naming); project folder stays WinEvo.Shell. -->
    <AssemblyName>WinEvo</AssemblyName>
    <UseWinUI>true</UseWinUI>

    <!-- Unpackaged app. This also switches on the WinAppSDK bootstrap
         auto-initializer, which is what lets the portable build start
         without a packaged identity — it is load-bearing, not leftover
         MSIX plumbing. WinEvo no longer produces an MSIX at all; see
         docs/distribution.md for why. -->
    <WindowsPackageType>None</WindowsPackageType>

    <!-- Bundle the WinAppSDK runtime when SelfContained=true. Set inside
         the csproj (not on the CLI) so the property does NOT propagate to
         ProjectReferences. Shell.Core also references WinAppSDK, and
         propagating WindowsAppSDKSelfContained=true to it makes both
         projects emit MsixContent, which then collides at publish with
         NETSDK1152 (duplicate WinAppSDK runtime files). -->
    <WindowsAppSDKSelfContained Condition="'$(SelfContained)' == 'true'">true</WindowsAppSDKSelfContained>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WinUI 3 patterns fight these two analyzers:
         CA1822: x:Bind binding helpers are instance methods by design.
         CA1001: Application cannot implement IDisposable; we dispose via Window.Closed. -->
    <NoWarn>$(NoWarn);CA1822;CA1001</NoWarn>
  </PropertyGroup>

  <!-- Package.appxmanifest and Images\ are intentionally NOT built. They are
       kept as source material for the Store listing and as the seed for a
       possible sparse package, not as packaging inputs. See
       docs/distribution.md. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinEvo.Shell.Core\WinEvo.Shell.Core.csproj" />

    <!-- Build-order-only reference so the agent exe is ready before we try to copy it. -->
    <ProjectReference Include="..\WinEvo.Agent\WinEvo.Agent.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the built-in action manifests next to the Shell. -->
    <Content Include="..\..\actions\**\*.json" LinkBase="actions">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Ship shared i18n string bundles (resolved by StringBundle at runtime). -->
    <Content Include="..\..\resources\Strings.*.json" LinkBase="resources">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Bring the Agent into the Shell's output under an agent\ subfolder. The
       two targets below cover both output paths: bin\ (dotnet build / run)
       and publish\ (dotnet publish). The subfolder layout dodges NETSDK1152
       — the Agent and Shell.Core both reference ActionModel / Ipc /
       Contracts, so a flat-merge collides on every shared transitive
       dependency.

       _AgentBinBase is the Agent project's base output dir without RID.
       _ResolveAgentOutputDir resolves AgentOutputDir to either the
       RID-specific subfolder (publish -r) or the RID-less fallback
       (default build). DependsOnTargets="ResolveProjectReferences" makes
       sure the Agent has actually built before we look for its files. -->
  <PropertyGroup>
    <_AgentBinBase>$(MSBuildProjectDirectory)\..\WinEvo.Agent\bin\$(Configuration)\net10.0-windows10.0.22000.0\</_AgentBinBase>
  </PropertyGroup>

  <Target Name="_ResolveAgentOutputDir" DependsOnTargets="ResolveProjectReferences">
    <PropertyGroup>
      <AgentOutputDir Condition="'$(RuntimeIdentifier)' != '' And Exists('$(_AgentBinBase)$(RuntimeIdentifier)\')">$(_AgentBinBase)$(RuntimeIdentifier)\</AgentOutputDir>
      <AgentOutputDir Condition="'$(AgentOutputDir)' == ''">$(_AgentBinBase)</AgentOutputDir>
    </PropertyGroup>
  </Target>

  <!-- Post-build Copy → handles dotnet build and dotnet run. -->
  <Target Name="CopyAgentBinaries" AfterTargets="Build" DependsOnTargets="_ResolveAgentOutputDir">
    <ItemGroup>
      <_AgentFiles Include="$(AgentOutputDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AgentFiles)"
          DestinationFiles="@(_AgentFiles->'$(OutputPath)agent\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="Exists('$(AgentOutputDir)')" />
  </Target>

  <!-- Post-publish Copy → handles unpackaged publish. -->
  <Target Name="CopyAgentBinariesToPublish" AfterTargets="Publish" DependsOnTargets="_ResolveAgentOutputDir">
    <ItemGroup>
      <_AgentPublishFiles Include="$(AgentOutputDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AgentPublishFiles)"
          DestinationFiles="@(_AgentPublishFiles->'$(PublishDir)agent\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="Exists('$(AgentOutputDir)') And '$(PublishDir)' != ''" />
  </Target>

</Project>
