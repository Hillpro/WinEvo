<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>WinEvo.Shell</RootNamespace>
    <!-- Output exe is WinEvo.exe (consumer-app naming); project folder stays WinEvo.Shell. -->
    <AssemblyName>WinEvo</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <!-- Strings\en\Resources.resw is the text every other language falls back to. -->
    <DefaultLanguage>en</DefaultLanguage>

    <!-- Unpackaged app. This also switches on the WinAppSDK bootstrap
         auto-initializer, which is what lets the portable build start
         without a packaged identity — it is load-bearing, not leftover
         MSIX plumbing. WinEvo no longer produces an MSIX at all; see
         docs/distribution.md for why. -->
    <WindowsPackageType>None</WindowsPackageType>

    <!-- Despite its name, this does not produce an MSIX (WindowsPackageType
         is None). It is what makes `dotnet publish` carry WinEvo.pri into
         the publish folder. That file holds the compiled XAML and every
         Resources.resw string; without it the published WinEvo.exe dies at
         startup with "XamlParseException: XAML parsing failed", while F5 and
         `dotnet run` keep working because the build output does have it.
         Removing this line with the rest of the MSIX setup broke the
         portable zip once already. -->
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- Bundle the WinAppSDK runtime when SelfContained=true. Set inside
         the csproj (not on the CLI) so the property does NOT propagate to
         ProjectReferences. Shell.Core also references WinAppSDK, and
         propagating WindowsAppSDKSelfContained=true to it makes both
         projects emit MsixContent, which then collides at publish with
         NETSDK1152 (duplicate WinAppSDK runtime files). -->
    <WindowsAppSDKSelfContained Condition="'$(SelfContained)' == 'true'">true</WindowsAppSDKSelfContained>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WinUI 3 patterns fight these two analyzers:
         CA1822: x:Bind binding helpers are instance methods by design.
         CA1001: Application cannot implement IDisposable; we dispose via Window.Closed. -->
    <NoWarn>$(NoWarn);CA1822;CA1001</NoWarn>
  </PropertyGroup>

  <!-- Package.appxmanifest and Images\ are intentionally NOT built. They are
       kept as source material for the Store listing and as the seed for a
       possible sparse package, not as packaging inputs. See
       docs/distribution.md. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinEvo.Shell.Core\WinEvo.Shell.Core.csproj" />
    <!-- The Shell only lists these actions and renders their descriptors;
         running them is the agent's job. -->
    <ProjectReference Include="..\WinEvo.Actions\WinEvo.Actions.csproj" />

    <!-- Not a code reference: it makes the agent build first, and reports
         where its output landed (item AgentBuildOutput) so it can be copied. -->
    <ProjectReference Include="..\WinEvo.Agent\WinEvo.Agent.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>AgentBuildOutput</OutputItemType>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- Bring the Agent into the Shell's output under an agent\ subfolder. The
       two targets below cover both output paths: bin\ (dotnet build / run)
       and publish\ (dotnet publish). The subfolder layout dodges NETSDK1152:
       the Agent and the Shell both reference Actions / Ipc / Contracts, so a
       flat merge collides on every shared transitive dependency.

       AgentOutputDir is the folder the Agent was built into by this very
       build, taken from the project reference. It is never derived from the
       runtime identifier: a win-x64\ folder left behind by an older publish
       would otherwise be picked up and shipped as if it were current. -->
  <Target Name="_ResolveAgentOutputDir" DependsOnTargets="ResolveProjectReferences">
    <PropertyGroup>
      <AgentOutputDir>@(AgentBuildOutput->'%(RootDir)%(Directory)')</AgentOutputDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(AgentOutputDir)WinEvo.Agent.exe')"
           Text="WinEvo.Agent.exe was not built (looked in '$(AgentOutputDir)'). The Shell cannot run actions without it." />
    <ItemGroup>
      <!-- Runtime-specific builds of the agent sit in subfolders of its
           framework-dependent output; they are separate builds, not part of
           this one. -->
      <_AgentFiles Include="$(AgentOutputDir)**\*.*" Exclude="$(AgentOutputDir)win-*\**" />
    </ItemGroup>
  </Target>

  <!-- Post-build Copy: handles dotnet build and dotnet run. -->
  <Target Name="CopyAgentBinaries" AfterTargets="Build" DependsOnTargets="_ResolveAgentOutputDir">
    <Copy SourceFiles="@(_AgentFiles)"
          DestinationFiles="@(_AgentFiles->'$(OutputPath)agent\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Post-publish Copy: handles the portable publish. -->
  <Target Name="CopyAgentBinariesToPublish" AfterTargets="Publish" DependsOnTargets="_ResolveAgentOutputDir"
          Condition="'$(PublishDir)' != ''">
    <!-- A self-contained Shell next to an agent that still needs .NET
         installed starts fine and then fails on the first action, on any
         machine without .NET. That happens when SelfContained and
         RuntimeIdentifier come only from the publish profile: they then
         apply to the Shell but not to the Agent. -->
    <Error Condition="'$(SelfContained)' == 'true' And !Exists('$(AgentOutputDir)coreclr.dll')"
           Text="The agent was built without its own .NET runtime, so the published app would only work where .NET is installed. Publish with: dotnet publish src/WinEvo.Shell -p:PublishProfile=Portable-win-x64 -p:SelfContained=true -p:RuntimeIdentifier=win-x64" />
    <Copy SourceFiles="@(_AgentFiles)"
          DestinationFiles="@(_AgentFiles->'$(PublishDir)agent\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
