<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinEvo.Shell.Views.ConfirmationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WinEvo.Shell.Views"
    DefaultButton="Close"
    CloseButtonText="Cancel">

    <!-- MinWidth/MaxWidth bound the dialog so long messages can wrap instead
         of expanding the dialog to the width of the window. -->
    <StackPanel Spacing="12" MinWidth="420" MaxWidth="480">

        <!-- Severity banner -->
        <Border x:Name="SeverityBanner" CornerRadius="4" Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon x:Name="SeverityIcon" Glyph="&#xE7BA;" FontSize="18" VerticalAlignment="Center" />
                <TextBlock x:Name="SeverityLabel"
                           Text="Warning"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Warnings list. Each row uses a Grid (not a horizontal StackPanel)
             so the message TextBlock has a bounded column width — without it,
             TextWrapping has nothing to wrap against and all text stays on
             a single line. -->
        <ItemsControl x:Name="WarningsList" HorizontalContentAlignment="Stretch">
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="views:WarningRow">
                    <Grid Margin="0,0,0,6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Glyph="{x:Bind Glyph}"
                                  Foreground="{x:Bind Foreground}"
                                  FontSize="14"
                                  VerticalAlignment="Top"
                                  Margin="0,2,0,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind Message}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Danger: explicit acknowledgement -->
        <CheckBox x:Name="AcknowledgeCheckbox"
                  Content="I understand the consequences."
                  Visibility="Collapsed"
                  Checked="OnGateStateChanged"
                  Unchecked="OnGateStateChanged" />

        <!-- Critical: typed-phrase challenge -->
        <StackPanel x:Name="TypedPhrasePanel" Spacing="4" Visibility="Collapsed">
            <TextBlock x:Name="TypedPhrasePrompt"
                       Text=""
                       TextWrapping="Wrap"
                       FontSize="12"
                       Opacity="0.8" />
            <TextBox x:Name="TypedPhraseInput"
                     PlaceholderText="Type here"
                     TextChanged="OnGateStateChanged" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
