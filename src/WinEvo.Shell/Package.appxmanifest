<?xml version="1.0" encoding="utf-8"?>

<!-- INERT — nothing builds this file.

     WinEvo no longer produces an MSIX. The Store refused the
     `unvirtualizedResources` capability twice, and without it a packaged
     build cannot write real HKCU. Full reasoning and every alternative
     that was closed off: docs/distribution.md. Distribution is the
     portable zip plus a signed installer.

     Kept because it still holds real information: the Partner Center
     Identity (Name + Publisher GUID) and the visual-asset declarations
     that go with Images\. If a sparse package is ever built for
     identity-gated features, it starts from here — and note that a sparse
     package IS subject to registry virtualization, so it would need
     `unvirtualizedResources` re-added. That is legal there: approval is
     only required when submitting a package to the Store, and a sparse
     package is registered by our own installer. -->

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap rescap desktop">

  <!-- Partner Center-assigned Identity for WinEvo. -->
  <Identity
    Name="Hillpro.WinEvo"
    Publisher="CN=FA93D602-3A7F-4710-9AD4-25441C81F429"
    Version="0.2.0.0" />

  <Properties>
    <DisplayName>WinEvo</DisplayName>
    <PublisherDisplayName>Hillpro</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26200.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- $targetnametoken$ resolves to the AssemblyName (WinEvo); $targetentrypoint$
         resolves to the WinUI 3 entry point. Replaced at packaging time. -->
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="WinEvo"
        Description="Take control of Windows 11. A friendly tool that helps you shape your PC around the way you actually use it."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png"  Square71x71Logo="Images\SmallTile.png" Square310x310Logo="Images\LargeTile.png"/>
        <uap:SplashScreen Image="Images\SplashScreen.png" />
      </uap:VisualElements>
      <!-- Declares WinEvo.Agent.exe as a full-trust helper inside this
           package. Required so the packaged Shell can spawn the Agent
           (Process.Start with Verb=runas) under MSIX sandbox rules.
           The Shell uses Process.Start directly rather than the
           FullTrustProcessLauncher API, so ParameterGroup is omitted —
           it would only matter for that API. -->
      <Extensions>
        <desktop:Extension Category="windows.fullTrustProcess" Executable="agent\WinEvo.Agent.exe" />
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Required for a Win32-style desktop app distributed via MSIX. The Shell
         still runs Medium IL — runFullTrust enables the desktop-app subsystem,
         not elevation. Elevation flows through the agent (UAC) per
         docs/architecture.md. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
