<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe (not Exe): suppresses the console window that would otherwise appear
         when the agent is launched with UseShellExecute=true + runas for UAC.
         Logs go to %LOCALAPPDATA%\WinEvo\agent.log via AgentLog, not stdout. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <RootNamespace>WinEvo.Agent</RootNamespace>
    <AssemblyName>WinEvo.Agent</AssemblyName>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Service-mode hosting packages (Microsoft.Extensions.Hosting[.WindowsServices],
       Logging.EventLog) are intentionally NOT referenced yet. Add them in the
       PR that wires the service/install modes (versions stay pinned in
       Directory.Packages.props). -->
  <ItemGroup>
    <ProjectReference Include="..\WinEvo.Agent.Core\WinEvo.Agent.Core.csproj" />
  </ItemGroup>

</Project>
