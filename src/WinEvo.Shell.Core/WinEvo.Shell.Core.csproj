<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <RootNamespace>WinEvo.Shell.Core</RootNamespace>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <!-- Strings.resx is the English text; every other language is a
         Strings.<lang>.resx compiled into a satellite assembly. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- DispatcherQueue type (Microsoft.UI.Dispatching) for UI marshaling. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>
  <!-- No DI container or Microsoft.Extensions.Logging: services are constructed
       directly in App.OnLaunched and diagnostics go through ShellLog (FileLog).
       At this scale a container would be over-engineering. -->


  <ItemGroup>
    <ProjectReference Include="..\WinEvo.Actions.Abstractions\WinEvo.Actions.Abstractions.csproj" />
    <ProjectReference Include="..\WinEvo.Ipc\WinEvo.Ipc.csproj" />
  </ItemGroup>

</Project>
