<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WinEvo.Contracts</RootNamespace>
  </PropertyGroup>

  <!-- The .proto file under Protos\ is the contract document for a future
       gRPC IPC swap. It is NOT codegened today: live IPC is JSON over a
       named pipe, no gRPC at runtime. Re-enable codegen when wiring gRPC
       by adding back PackageReferences to Grpc.Tools, Google.Protobuf, and
       (depending on side) Grpc.AspNetCore / Grpc.Net.Client, plus a
       <Protobuf Include="Protos\agent-service.proto" GrpcServices="Both" />
       item. -->

</Project>
